{
  "name": "hall-of-fame-studio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build && node scripts/build-single-html.cjs",
    "agents:scenario": "node scripts/validate-agent-manager-scenario.mjs",
    "agents:product-team": "node scripts/validate-product-team-acceptance-scenario.mjs",
    "adapters:gateway": "node scripts/validate-adapter-gateway-contract.mjs",
    "adapters:gateway-server": "node scripts/adapter-gateway-server.mjs",
    "adapters:gateway-server:validate": "node scripts/validate-adapter-gateway-server.mjs",
    "adapters:gateway-postgres-store:validate": "node scripts/validate-adapter-gateway-postgres-store.mjs",
    "agents:server": "node scripts/agent-project-server.mjs",
    "preview": "vite preview",
    "ui:manager-demo": "npm run build && node scripts/validate-manager-demo-ui.mjs",
    "ui:manager-backend": "npm run build && node scripts/validate-manager-backend-ui.mjs",
    "ui:language": "npm run build && node scripts/validate-language-system.mjs",
    "skills:blend": "node scripts/validate-persona-skill-blends.mjs",
    "skills:validate": "python skills/hall-of-fame-personas/scripts/validate_personas.py",
    "skills:regression": "python skills/hall-of-fame-personas/scripts/regression_check.py",
    "skills:check": "npm run skills:validate && npm run skills:regression",
    "readme:capture": "node scripts/capture-readme-demos.mjs",
    "readme:gif": "node scripts/build-demo-animations.mjs",
    "readme:export": "node scripts/export-logo-png.mjs && node scripts/export-hero-png.mjs",
    "readme:assets": "npm run readme:capture && npm run readme:gif && npm run readme:export"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "gifenc": "^1.0.3",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.11"
  }
}
