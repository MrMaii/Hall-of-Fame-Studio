# Copy this file to `.env` and point it at a local OpenAI-compatible runtime
# such as Ollama. The local server rejects public provider endpoints by default.

AGENT_LOCAL_ONLY=true

# Local provider selection through the generic OpenAI-compatible adapter.
MODEL_PROVIDER_ENABLED=true
MODEL_PROVIDER=openai-compatible
MODEL_API_KEY=
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=llama3.2

# Optional safety rail. Comma-separated exact names, substrings, or wildcard patterns.
MODEL_BLOCKED_MODELS=

MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=1200
MODEL_TIMEOUT_MS=45000
MODEL_MAX_CONCURRENCY=2
MODEL_JSON_RESPONSE_FORMAT=false
MODEL_EXTRA_BODY={"reasoning_effort":"low"}

# Optional local evidence-search provider. Keep disabled unless you run a local/private
# search gateway. Public endpoints are rejected while AGENT_LOCAL_ONLY=true.
SEARCH_PROVIDER_ENABLED=false
SEARCH_PROVIDER=none
SEARCH_API_KEY=
SEARCH_ENDPOINT=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_MS=20000
SEARCH_MAX_CONCURRENCY=2
# Optional JSON template merged into the provider request.
SEARCH_REQUEST_TEMPLATE={}

# Local encrypted secret-vault contract for BYOK pilots. This is a local envelope
# vault used by readiness gates; public production should replace it with managed KMS.
# Product-team validation also rehearses key rotation with secret-vault-rotation-receipt/v1.
SECRET_VAULT_ENABLED=false
SECRET_VAULT_KEY=
SECRET_VAULT_KEY_ID=local-env
# Optional JSON array of secret-vault-record/v1 encrypted records.
SECRET_VAULT_RECORDS_JSON=[]

# Prototype provider governance. Keep enforced only for private/local pilots until
# identity, secret vault, and managed audit storage are production-ready.
PROVIDER_CONTROL_ENABLED=false
PROVIDER_CONTROL_MODE=enforced
PROVIDER_ALLOWED_MODEL_PROVIDERS=openai-compatible
PROVIDER_ALLOWED_SEARCH_PROVIDERS=deterministic,http-json
PROVIDER_ALLOWED_MODELS=
PROVIDER_ALLOWED_SEARCH_ENDPOINT_HOSTS=
PROVIDER_MAX_REQUESTS_PER_PROJECT_HOUR=100
PROVIDER_DAILY_BUDGET_CENTS=500
PROVIDER_MODEL_COST_CENTS_PER_1K_TOKENS=0
PROVIDER_SEARCH_COST_CENTS_PER_REQUEST=0
PROVIDER_DEFAULT_TOOL_GRANTS=provider:test,model:kickoff,model:intent,search:evidence
# Local provider failure controls. These prove retry/circuit-breaker behavior for
# pilots; production still needs centralized incident handling and alerting.
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BACKOFF_MS=1000,3000
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_WINDOW_MINUTES=15
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60

# Backend runtime. Deployment preflight reports these settings through
# GET /projects/:id/deployment-preflight without exposing secret values.
AGENT_PROJECT_HOST=127.0.0.1
AGENT_PROJECT_PORT=8787
AGENT_AUTONOMOUS_SCHEDULER=false
AGENT_AUTONOMOUS_INTERVAL_MS=60000
# prototype-open keeps local demos backward compatible. Use enforced to require
# x-hofs-access-mode / x-hofs-role / x-hofs-agent-id headers on backend routes.
AGENT_ACCESS_CONTROL_MODE=prototype-open
# Optional HMAC signing secret for enforced access headers. When set, enforced
# requests must include x-hofs-signed-at and x-hofs-signature.
AGENT_ACCESS_SIGNING_SECRET=
# Optional replay guard for signed enforced requests. When enabled, clients also
# sign x-hofs-request-id and the file-backed backend accepts each id once per
# freshness window, including after a local API restart.
AGENT_ACCESS_REPLAY_PROTECTION=false
# Optional production-style guard. When enabled, enforced project access is denied
# if the backend cannot write the security access audit record before dispatch.
AGENT_ACCESS_AUDIT_FAIL_CLOSED=false

# Managed persistence adapter cutover.
# local-shadow is the default MVP verifier. postgres/http-json are reserved for
# a real managed database adapter or private adapter gateway.
MANAGED_PERSISTENCE_ADAPTER_DRIVER=local-shadow
MANAGED_PERSISTENCE_DATABASE_URL=
MANAGED_PERSISTENCE_HTTP_ENDPOINT=
# Optional shared private adapter gateway. When set, both managed persistence
# and worker queue http-json dry-runs can use this endpoint through API routes.
ADAPTER_GATEWAY_HTTP_ENDPOINT=
ADAPTER_GATEWAY_AUTH_TOKEN=
ADAPTER_GATEWAY_TIMEOUT_MS=8000
# Reference local private adapter gateway process.
ADAPTER_GATEWAY_HOST=127.0.0.1
ADAPTER_GATEWAY_PORT=8797
ADAPTER_GATEWAY_STORAGE_DRIVER=json-file
ADAPTER_GATEWAY_STORE=.tmp/adapter-gateway-store.json
# Optional Postgres-compatible store rehearsal. The reference script validates
# schema/upsert/readback-parity operations with a bound query function before real DB cutover.
ADAPTER_GATEWAY_POSTGRES_URL=
ADAPTER_GATEWAY_POSTGRES_SCHEMA=hofs_gateway
ADAPTER_GATEWAY_MAX_BODY_BYTES=26214400
# Set true only for production cutover rehearsals; local shadow runs must keep
# production database cutover blocked.
MANAGED_PERSISTENCE_REQUIRE_REAL_ADAPTER=false

# Worker queue adapter cutover.
# local-shadow is the default MVP verifier. http-json/managed-queue are reserved
# for a real queue adapter or private queue gateway.
WORKER_QUEUE_ADAPTER_DRIVER=local-shadow
WORKER_QUEUE_HTTP_ENDPOINT=
# Set true only for production cutover rehearsals; local shadow runs must keep
# production queue cutover blocked.
WORKER_QUEUE_REQUIRE_REAL_ADAPTER=false

# Optional stores. Defaults write under .tmp/.
# AGENT_PROJECT_STORE=.tmp/agent-project-store.json
# Defaults to `${AGENT_PROJECT_STORE}.security-audit.jsonl`.
# AGENT_SECURITY_AUDIT_LOG=.tmp/agent-project-store.json.security-audit.jsonl
# AGENT_ARTIFACT_ROOT=.tmp/agent-artifacts

# Bounded local observability and SLO trends. Warning windows must repeat before
# alerting; one critical window alerts immediately. All values stay on this machine.
AGENT_LOCAL_TELEMETRY_LOG=.tmp/agent-runtime-observability.jsonl
AGENT_LOCAL_TELEMETRY_MAX_RECORDS=500
AGENT_LOCAL_TELEMETRY_MAX_FILE_BYTES=1000000
AGENT_LOCAL_ERROR_MAX_ISSUES=100
AGENT_LOCAL_SLO_WINDOW_SIZE=20
AGENT_LOCAL_SLO_SNAPSHOT_EVERY_REQUESTS=20
AGENT_LOCAL_SLO_MIN_SAMPLES=10
AGENT_LOCAL_SLO_WARNING_P95_MS=2000
AGENT_LOCAL_SLO_CRITICAL_P95_MS=10000
AGENT_LOCAL_SLO_MAX_SERVER_ERROR_RATE=0.1
AGENT_LOCAL_SLO_CONSECUTIVE_BREACH_WINDOWS=2
AGENT_LOCAL_SLO_MAX_SNAPSHOTS=120
